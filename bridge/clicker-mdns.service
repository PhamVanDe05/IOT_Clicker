# User service: keeps clicker.local pointing at this laptop's current Wi-Fi IP.
#   mkdir -p ~/.config/systemd/user
#   cp bridge/clicker-mdns.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now clicker-mdns
#   journalctl --user -u clicker-mdns -f
[Unit]
Description=Classroom Clicker mDNS name (clicker.local)
After=network-online.target avahi-daemon.service

[Service]
ExecStart=/usr/bin/python3 -u /home/pham-van-de/Desktop/IOT/clicker/bridge/clicker_mdns.py
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
