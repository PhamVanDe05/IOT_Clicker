# User service: runs the BLE bridge whenever you are logged in on the server laptop.
#   mkdir -p ~/.config/systemd/user
#   cp bridge/clicker-ble-bridge.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now clicker-ble-bridge
#   journalctl --user -u clicker-ble-bridge -f
[Unit]
Description=Classroom Clicker BLE bridge (nRF52840 Student Tags)
After=bluetooth.target

[Service]
ExecStart=/usr/bin/python3 -u /home/pham-van-de/Desktop/IOT/clicker/bridge/ble_bridge.py
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
